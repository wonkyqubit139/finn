# Copy to .env and fill in. Everything is optional: without a key, FINN
# classifies filings by rules only and skips LLM features.

# Free key from https://aistudio.google.com/apikey — used for both tiers by default.
GEMINI_API_KEY=

# Optional overrides (any OpenAI-compatible endpoint works, e.g. Groq):
# FINN_FAST_BASE_URL=https://api.groq.com/openai/v1
# FINN_FAST_API_KEY=gsk_...
# FINN_FAST_MODEL=openai/gpt-oss-20b
# FINN_FAST_MODEL=gemini-flash-lite-latest
# FINN_DEEP_MODEL=gemini-flash-latest

# Background refresh every N minutes (0 = off). Days of filings to backfill.
FINN_REFRESH_MINUTES=30
FINN_LOOKBACK_DAYS=10
